# SkillLab - static Next.js export on Hostinger (LiteSpeed)
#
# The frontend was exported as flat files: /user -> user.html,
# /admin/dashboard -> admin/dashboard.html, and so on. But every route
# also has a same-named folder (Next.js payload files) with NO
# index.html inside it, so opening /user/ or /admin/ directly hits the
# folder and the server answers 403 Forbidden.
#
# Fix: if the requested path has a matching "<path>.html" file, serve
# that file. Real files are always served as-is, and nothing without a
# matching .html (e.g. everything under /backend) is touched.

RewriteEngine On

# Real files (assets, images, .html pages themselves) - serve as-is.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# /user/ -> user.html, /user -> user.html,
# /admin/dashboard/ -> admin/dashboard.html, ...
# (skipped when the folder has its own index.html)
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
