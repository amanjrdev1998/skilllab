# Used only when this public/ folder is the document root itself
# (e.g. an api.yourdomain.com subdomain pointed at backend/public).
# Routes pretty URLs like /api/v1/courses to index.php.
RewriteEngine On

RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
