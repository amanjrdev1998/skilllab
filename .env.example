# ============================================================
# SkillLab frontend environment
# Copy to .env.local for local dev, or set these in your host
# (Vercel / cPanel / VPS) dashboard for production.
# ============================================================

# Core PHP API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# When the frontend and the PHP API are served from DIFFERENT
# origins in production, the Next.js API routes proxy to this:
# BACKEND_API_URL=https://api.yourdomain.com

# ---- PayPal ----
# SANDBOX (testing): paste the sandbox app Client ID here.
# LIVE (real money): replace with the LIVE app Client ID from
# https://developer.paypal.com/dashboard/applications
# and set PAYPAL_ENV=live in backend/.env with the live secret.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=AZd_g-rxd3B9oUDDMbuozaikaWEEAdNSBKCcqyfFnIR2SvX3KyJjmfCX3Rw4quj7qmCMaGTFYXUALaq6

# Public site URL (used by sitemap.xml and SEO tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
